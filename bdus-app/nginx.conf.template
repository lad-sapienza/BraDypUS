# Nginx configuration template for the bdus-app production container.
# Processed at container start by the official nginx:alpine entrypoint:
# files in /etc/nginx/templates/ are run through envsubst automatically.
#
# Required environment variable:
#   API_PROXY_TARGET  — URL of the bdus-api backend reachable from this
#                       container, e.g. http://api:80 (Docker Compose service)
#                       or https://api.example.com (external host).
#                       Default: http://api:80

# Preserve the scheme the browser used. When this container sits behind an
# outer TLS-terminating proxy, that proxy sends X-Forwarded-Proto: https;
# forward it unchanged (first token if several proxies chained) so the PHP
# backend builds https:// URLs — e.g. the OAuth redirect_uri. With no such
# header (direct access, dev) fall back to this connection's scheme.
map $http_x_forwarded_proto $bdus_forwarded_proto {
    default       $scheme;
    "~*^(https?)" $1;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Must be >= the API's post_max_size (72M in the bdus-api image) or large
    # file uploads are rejected here with 413 before reaching PHP.
    client_max_body_size 100m;

    # Baseline security headers (the app itself sets none). Inherited by the
    # proxied locations below — none set their own add_header. HSTS and any
    # CSP belong on the outer TLS-terminating proxy.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ── SPA fallback ──────────────────────────────────────────────────────
    # All paths that do not match a static file are served as index.html so
    # that Vue Router (history mode) handles client-side navigation, including
    # deep links and hard refreshes on clean-path URLs like /myapp/data.
    # The proxied prefixes below take precedence, so /api, /index.php,
    # /projects and /cache can never be used as application names.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Backend proxy ─────────────────────────────────────────────────────
    # Mirrors the paths proxied by Vite in dev (see bdus-app/vite.config.js).
    # Traffic never leaves the Docker network — no CORS headers needed.

    location /api/ {
        proxy_pass         ${API_PROXY_TARGET};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $bdus_forwarded_proto;
    }

    location /index.php {
        proxy_pass         ${API_PROXY_TARGET};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $bdus_forwarded_proto;
    }

    location /projects/ {
        proxy_pass         ${API_PROXY_TARGET};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $bdus_forwarded_proto;
    }

    location /cache/ {
        proxy_pass         ${API_PROXY_TARGET};
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $bdus_forwarded_proto;
    }
}
