# ════════════════════════════════════════════════════════════════════
# Phase 51 — The system groups do what they declare, over HTTP (#51)
#
# For each of Reader, Self writer and Writer, two people run the very same
# requests on crud_test: one at the privilege level (30, 25, 20), one at level
# Enter in the system group of the same name. Both must get the declared
# outcome, so the group is checked against the level and against the
# documentation. "Own" is a record the person created; "other" one the admin
# created. (GENERATED by the author's script from a table of expectations;
# edit the table, not this file, when behaviour is meant to change.)
#
# Declared: Reader reads; Self writer reads and creates, changes and deletes
# only their own; Writer does it all.
# ════════════════════════════════════════════════════════════════════


GET {{base_url}}/{{app_name}}/api/groups
Authorization: Bearer {{jwt}}
HTTP 200
[Asserts]
jsonpath "$.groups[?(@.name=='Reader')].system" == true
[Captures]
g51_reader: jsonpath "$.groups[?(@.name=='Reader')].id"
g51_selfwriter: jsonpath "$.groups[?(@.name=='Self writer')].id"
g51_writer: jsonpath "$.groups[?(@.name=='Writer')].id"

# ── 51 Reader: level 30 ────────────────────
POST {{base_url}}/{{app_name}}/api/user
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "name": "g51_reader_level", "email": "g51_reader_level@bdus.test", "password": "Parity_2025!x", "privilege": 30 }
HTTP 200
[Captures]
g51_reader_level_id: jsonpath "$.id"

POST {{base_url}}/{{app_name}}/api/auth/login
Content-Type: application/json
{ "email": "g51_reader_level@bdus.test", "password": "Parity_2025!x", "app": "{{app_name}}" }
HTTP 200
[Captures]
g51_reader_level_jwt: jsonpath "$.token"

# two records by the admin: one to try to change, one to try to delete
POST {{base_url}}/{{app_name}}/api/record/crud_test
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "core": { "sigla": "G511", "tipo": "g51" }, "plugins": {} }
HTTP 200
[Captures]
g51_reader_level_upd: jsonpath "$.id"

POST {{base_url}}/{{app_name}}/api/record/crud_test
Authorization: Bearer {{jwt}}
Content-Type: application/json
{ "core": { "sigla": "G512", "tipo": "g51" }, "plugins": {} }
HTTP 200
[Captures]
g51_reader_level_del: jsonpath "$.id"

GET {{base_url}}/{{app_name}}/api/records/crud_test?per_page=1
Authorization: Bearer {{jwt}}
HTTP 200
[Captures]
g51_reader_level_total: jsonpath "$.total"

# reads everything
GET {{base_url}}/{{app_name}}/api/records/crud_test?per_page=1
Authorization: Bearer {{g51_reader_level_jwt}}
HTTP 200
[Asserts]
jsonpath "$.total" == {{g51_reader_level_total}}

# create
POST {{base_url}}/{{app_name}}/api/record/crud_test
Authorization: Bearer {{g51_reader_level_jwt}}
Content-Type: application/json
{ "core": { "sigla": "G513", "tipo": "g51" }, "plugins": {} }
HTTP 200
[Asserts]
jsonpath "$.status" == "error"
jsonpath "$.code"   == "not_enough_privilege"

# change someone else's
POST {{base_url}}/{{app_name}}/api/record/crud_test
Authorization: Bearer {{g51_reader_level_jwt}}
Content-Type: application/json
{ "id": {{g51_reader_level_upd}}, "core": { "descrizione": "by g51_reader_level" } }
HTTP 200
[Asserts]
jsonpath "$.status" == "error"
jsonpath "$.code"   == "not_enough_privilege"

# delete someone else's
DELETE {{base_url}}/{{app_name}}/api/record/crud_test/{{g51_reader_level_del}}
Authorization: Bearer {{g51_reader_level_jwt}}
HTTP 200
[Asserts]
jsonpath "$.status" == "error"

DELETE {{base_url}}/{{app_name}}/api/user/{{g51_reader_level_id}}
Authorization: Bearer {{jwt}}
HTTP 200

DELETE {{base_url}}/{{app_name}}/api/record/crud_test/{{g51_reader_level_upd}}
Authorization: Bearer {{jwt}}
HTTP 200

DELETE {{base_url}}/{{app_name}}/api/record/crud_test/{{g51_reader_level_del}}
Authorization: Bearer {{jwt}}
HTTP 200


